# 서버 함수(api/) 전용 환경변수. VITE_ 접두사를 붙이지 말 것 (클라이언트 번들에 노출됨).
# 로컬: .env.local 로 복사 / 배포: Vercel 프로젝트 Settings → Environment Variables

# 켤 공급자 목록 (쉼표 구분). 비워두면 전부 활성화
# kurly,daangn,ohou,bunjang,coupang,daiso,oliveyoung,cinema
PROVIDERS_ENABLED=

# 쿠팡 파트너스 Open API (없으면 k-skill-proxy fallback)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
KSKILL_PROXY_BASE_URL=https://k-skill-proxy.nomadamas.org

# 사용자 데이터 원본 저장소 (Postgres / Neon). Vercel → Storage → Neon 연결 시 자동 주입.
# 테이블은 첫 요청 때 자동으로 만든다. 비워두면 브라우저(localStorage)에만 저장하는 로컬 전용 모드.
DATABASE_URL=

# 매장 재고 조회 캐시 (Upstash Redis). Vercel → Storage → Upstash for Redis 연결 시 자동 주입.
# 비워두면 캐시 없이 매번 조회한다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 카카오 로그인 (아이디 찾기·비밀번호 없는 로그인). 비우면 카카오 버튼이 숨겨진다.
# developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# 카카오 로그인 활성화 + Redirect URI 등록: https://<도메인>/auth/kakao (로컬은 http://localhost:5173/auth/kakao)
KAKAO_REST_API_KEY=
# 카카오 로그인 → 보안 → Client Secret을 "사용함"으로 했을 때만
KAKAO_CLIENT_SECRET=
# 비우면 요청이 들어온 주소의 /auth/kakao를 쓴다. 프록시 뒤라 주소가 다르게 보이면 고정
KAKAO_REDIRECT_URI=
